# Local SDK path — machine-specific, never commit
local.properties

# Gradle
.gradle/
build/
app/build/
gradle/wrapper/gradle-wrapper.jar

# Android Studio
.idea/
*.iml
.DS_Store

# Keystores — never commit signing keys
*.jks
*.keystore

